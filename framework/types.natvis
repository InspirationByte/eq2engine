<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="RawItem&lt;*&gt;">
		<Intrinsic Name="Item" Expression="*($T1*)&amp;data"></Intrinsic>
		<DisplayString>{ Item() }</DisplayString>
		<Expand>
			<ExpandedItem>Item()</ExpandedItem>
		</Expand>
	</Type>
	<Type Name="ArrayBase&lt;*, DynamicArrayStorage&lt;*&gt;&gt;">
		<DisplayString Condition="m_pListPtr == 0">[unallocated]</DisplayString>
		<Expand>
			<Synthetic Name="Items">
				<DisplayString Condition="m_pListPtr == 0">[unallocated]</DisplayString>
				<DisplayString>[count: { m_nNumElem }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m_nNumElem</Size>
						<ValuePointer>m_pListPtr</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>

			<Item Name="Allocated">
				m_nSize
			</Item>
			<Item Name="Granularity">
				m_nGranularity
			</Item>
		</Expand>
	</Type>
	<Type Name="ArrayBase&lt;*, FixedArrayStorage&lt;*&gt;&gt;">
		<DisplayString Condition="m_data == 0">[unallocated]</DisplayString>
		<Expand>
			<Synthetic Name="Items">
				<DisplayString Condition="m_data == 0">[unallocated]</DisplayString>
				<DisplayString>[count: { m_nNumElem }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m_nNumElem</Size>
						<ValuePointer>m_data</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>
	<Type Name="ArrayRef&lt;*&gt;">
		<DisplayString Condition="m_pListPtr == 0">[unallocated]</DisplayString>
		<Expand>
			<Synthetic Name="Items">
				<DisplayString Condition="m_pListPtr == 0">[unallocated]</DisplayString>
				<DisplayString>[count: { m_nNumElem }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m_nNumElem</Size>
						<ValuePointer>m_pListPtr</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>
	<Type Name="ArrayCRef&lt;*&gt;">
		<DisplayString Condition="m_pListPtr == 0">[unallocated]</DisplayString>
		<Expand>
			<Synthetic Name="Items">
				<DisplayString Condition="m_pListPtr == 0">[unallocated]</DisplayString>
				<DisplayString>[count: { m_nNumElem }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m_nNumElem</Size>
						<ValuePointer>m_pListPtr</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>
	<Type Name="ListBase&lt;*,FixedListAllocator&lt;*&gt;&gt;">
		<DisplayString Condition="m_count == 0">[empty]</DisplayString>
		<DisplayString>items: { m_count }</DisplayString>
		<Expand>
			<Synthetic Name="Items">
				<DisplayString>count: { m_count }</DisplayString>
				<Expand>
					<LinkedListItems>
						<HeadPointer>m_first</HeadPointer>
						<NextPointer>next</NextPointer>
						<ValueNode>value</ValueNode>
					</LinkedListItems>
				</Expand>
			</Synthetic>
			<Item Name="First">m_first</Item>
			<Item Name="Last">m_last</Item>
		</Expand>
	</Type>
	<Type Name="ListBase&lt;*,DynamicListAllocator&lt;*&gt;&gt;">
		<DisplayString Condition="m_count == 0">[empty]</DisplayString>
		<DisplayString>items: { m_count }</DisplayString>
		<Expand>
			<Synthetic Name="Items">
				<DisplayString>count: { m_count }</DisplayString>
				<Expand>
					<LinkedListItems>
						<HeadPointer>m_first</HeadPointer>
						<NextPointer>next</NextPointer>
						<ValueNode>value</ValueNode>
					</LinkedListItems>
				</Expand>
			</Synthetic>
			<Item Name="First">m_first</Item>
			<Item Name="Last">m_last</Item>
		</Expand>
	</Type>
	<Type Name="Map&lt;*,*&gt;">
		<DisplayString Condition="m_size == 0">[empty]</DisplayString>
		<DisplayString>items: { m_size }</DisplayString>
		<Expand>
			<Synthetic Condition="strcmp(&quot;$T2&quot;,&quot;_EMPTY_VALUE&quot;)!=0" Name="Items">
				<DisplayString>count: { m_size }</DisplayString>
				<Expand>
					<TreeItems>
						<Size>m_size</Size>
						<HeadPointer>m_root</HeadPointer>
						<LeftPointer>left</LeftPointer>
						<RightPointer>right</RightPointer>
						<ValueNode Name="[{key}]">*($T2*)&amp;value.data</ValueNode>
					</TreeItems>
				</Expand>
			</Synthetic>
			<Synthetic Condition="strcmp(&quot;$T2&quot;,&quot;_EMPTY_VALUE&quot;)==0" Name="Items">
				<DisplayString>count: { m_size }</DisplayString>
				<Expand>
					<TreeItems>
						<Size>m_size</Size>
						<HeadPointer>m_root</HeadPointer>
						<LeftPointer>left</LeftPointer>
						<RightPointer>right</RightPointer>
						<ValueNode>key</ValueNode>
					</TreeItems>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>

	<Type Name="CRefPtr&lt;*&gt;">
		<SmartPointer Usage="Minimal">m_ptrObj</SmartPointer>
		<DisplayString Condition="m_ptrObj == nullptr">&lt;nullptr&gt;</DisplayString>
		<DisplayString Condition="m_ptrObj != nullptr">[refs: { m_ptrObj->m_numRefs }] { m_ptrObj }</DisplayString>
		<Expand>
			<ExpandedItem Condition="m_ptrObj != nullptr">
				m_ptrObj
			</ExpandedItem>
			<Item Name="Ref Count" Condition="m_ptrObj != nullptr">
				m_ptrObj->m_numRefs
			</Item>
		</Expand>
	</Type>
	<Type Name="CWeakPtr&lt;*&gt;">
		<Intrinsic Name="Item" Expression="($T1*)m_weakRefPtr->ptr"></Intrinsic>
		
		<SmartPointer Usage="Minimal">Item()</SmartPointer>
		<DisplayString Condition="m_weakRefPtr == nullptr">[nullptr]</DisplayString>
		<DisplayString>{ Item() }</DisplayString>
		<Expand>
			<ExpandedItem>
				Item()
			</ExpandedItem>
			<Item Name="Ref Count">
				m_weakRefPtr->numRefs
			</Item>
		</Expand>
	</Type>

	<Type Name="EqTStr&lt;*&gt;">
		<DisplayString Condition="m_nLength == 0">[empty str]</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;wchar_t&quot;) == 0">[wstring] { m_pszString,su }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;char&quot;) == 0">[string] { m_pszString,sb }</DisplayString>
		<Expand>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;char&quot;) == 0" Name="Value">m_pszString,sb</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;wchar_t&quot;) == 0" Name="Value">m_pszString,su</Item>
			<Item Name="Length">
				m_nLength
			</Item>
			<Item Name="Allocated">
				m_nAllocated
			</Item>
		</Expand>
	</Type>
	<Type Name="EqTStrRef&lt;*&gt;">
		<DisplayString Condition="m_nLength == 0">[empty str ref]</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;char&quot;) == 0">[string ref] { m_pszString,sb }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;wchar_t&quot;) == 0">[wstring ref] { m_pszString,su }</DisplayString>
		<Expand>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;char&quot;) == 0" Name="Value">m_pszString,sb</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;wchar_t&quot;) == 0" Name="Value">m_pszString,su</Item>
			<Item Name="Length">
				m_nLength
			</Item>
		</Expand>
	</Type>
	
	<!--
		PPMEM
	-->
	<Type Name="PPSourceLine">
		<DisplayString Condition="data == 0">[empty]</DisplayString>
		<DisplayString Condition="data != 0">[{ (const char*)(data &amp; ((1ULL &lt;&lt; PPSL_ADDR_BITS) - 1)),sb }]:{ int((data &gt;&gt; PPSL_ADDR_BITS) &amp; ((1 &lt;&lt; 16) - 1)) }</DisplayString>
		<Expand>
			<Item Name="filename">
				(const char*)(data &amp; ((1ULL &lt;&lt; PPSL_ADDR_BITS) - 1))
			</Item>
			<Item Name="line">
				int((data &gt;&gt; PPSL_ADDR_BITS) &amp; ((1 &lt;&lt; 16) - 1))
			</Item>
		</Expand>
	</Type>
	
	<Intrinsic Name="PPMemStat" Expression="s_memStateList"></Intrinsic>
	<Type Name="PPMemStateList">
		<Intrinsic Name="State" Expression="*(PPMemState**)&amp;m_data[idx].data">
			<Parameter Name="idx" Type="int"/>
		</Intrinsic>
		<Expand HideRawView="true">
			<CustomListItems>
				<Variable Name="mem" InitialValue="0"/>
				<Variable Name="count" InitialValue="0"/>
				<Variable Name="i" InitialValue="0"/>
				<Loop>
					<If Condition="i >= m_nNumElem">
						<Item Name="Total memory (MB)">mem / 1024.0 / 1024.0</Item>
						<Item Name="Total allocs">count</Item>
						<Break />
					</If>
					<Exec>mem += State(i)->allocMemCounter</Exec>
					<Exec>count += State(i)->numAllocs</Exec>
					<Exec>++i</Exec>
				</Loop>
			</CustomListItems>
			<Synthetic Name="TLS Counters">
				<DisplayString Condition="m_data == 0">[unallocated]</DisplayString>
				<DisplayString>[count: { m_nNumElem }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m_nNumElem</Size>
						<ValuePointer>m_data</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>

	<!--
		Other Framework Types
	-->
	<Type Name="FReal">
		<DisplayString>[fix] {(float)raw / (float)FPMATH_ONE}</DisplayString>
	</Type>
	
	<Type Name="KVSection">
		<DisplayString Condition="keys.m_nNumElem == 0 &amp;&amp; values.m_nNumElem == 0">"{name,sb}"</DisplayString>
		<DisplayString Condition="keys.m_nNumElem == 0">"{name,sb}" [Values: {values.m_nNumElem}]</DisplayString>
		<DisplayString Condition="values.m_nNumElem == 0">"{name,sb}" {{ Keys: {keys.m_nNumElem} }}</DisplayString>
		<DisplayString>"{name,sb}" [Values: {values.m_nNumElem}] {{ Keys: {keys.m_nNumElem} }}</DisplayString>
		<Expand>
			<Synthetic Name="Values" Condition="values.m_nNumElem > 0">
				<DisplayString>{ values }</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>values.m_nNumElem</Size>
						<ValuePointer>values.m_pListPtr,na</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<ArrayItems>
				<Size>keys.m_nNumElem</Size>
				<ValuePointer>keys.m_pListPtr,na</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="KVPairValue">
		<DisplayString Condition="type == KVPAIR_STRING">[string] { value,sb }</DisplayString>
		<DisplayString Condition="type == KVPAIR_INT">[int] { nValue }</DisplayString>
		<DisplayString Condition="type == KVPAIR_FLOAT">[float] { fValue }</DisplayString>
		<DisplayString Condition="type == KVPAIR_BOOL">[bool] { bValue }</DisplayString>
		<DisplayString Condition="type == KVPAIR_SECTION">[section] { section }</DisplayString>
	</Type>

	<!--
		MatSystem Types
	-->
	<Type Name="ITexture">
		<DisplayString>RHI Texture { ((CTexture*)this)->m_name }</DisplayString>
	</Type>
	<Type Name="IMaterial">
		<DisplayString>Material { ((CMaterial*)this)->m_name }</DisplayString>
	</Type>
	<Type Name="MatVarProxy&lt;*&gt;">
		<DisplayString Condition="m_matVarIdx == -1">MatVarProxy [empty]</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;EqString&quot;) == 0">{ (*m_vars).variables.m_pListPtr[m_matVarIdx].strValue }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;CRefPtr&lt;ITexture&gt;&quot;) == 0">{ (*m_vars).variables.m_pListPtr[m_matVarIdx].texture }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;int&quot;) == 0">{ (*m_vars).variables.m_pListPtr[m_matVarIdx].intValue }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;float&quot;) == 0">{ (*m_vars).variables.m_pListPtr[m_matVarIdx] }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;TVec2D&lt;float&gt;&quot;) == 0">{ (TVec2D&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;TVec3D&lt;float&gt;&quot;) == 0">{ (TVec3D&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;TVec4D&lt;float&gt;&quot;) == 0">{ (TVec4D&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;Matrix3x3;&quot;) == 0">{ (TMat3&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector }</DisplayString>
		<DisplayString Condition="strcmp(&quot;$T1&quot;,&quot;Matrix4x4;&quot;) == 0">{ (TMat4&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector }</DisplayString>
		<Expand>
			<Item Name="String value">
				(*m_vars).variables.m_pListPtr[m_matVarIdx].strValue
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;CRefPtr&lt;ITexture&gt;&quot;) == 0" Name="Value">
				(*m_vars).variables.m_pListPtr[m_matVarIdx].texture
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;int;&quot;) == 0" Name="Value">
				(*m_vars).variables.m_pListPtr[m_matVarIdx].intValue
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;float;&quot;) == 0" Name="Value">
				(*m_vars).variables.m_pListPtr[m_matVarIdx].vector[0]
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;TVec2D&lt;float&gt;&quot;) == 0" Name="Value">
				(TVec2D&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;TVec3D&lt;float&gt;&quot;) == 0" Name="Value">
				(TVec3D&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;TVec4D&lt;float&gt;&quot;) == 0" Name="Value">
				(TVec4D&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;Matrix3x3;&quot;) == 0" Name="Value">
				(TMat3&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector
			</Item>
			<Item Condition="strcmp(&quot;$T1&quot;,&quot;Matrix4x4;&quot;) == 0" Name="Value">
				(TMat4&lt;float&gt;*)(*m_vars).variables.m_pListPtr[m_matVarIdx].vector
			</Item>
		</Expand>
	</Type>
	
	<!--
		Engine Types
	-->
	<Type Name="studioModelHeader_s">
		<DisplayString>EGF { modelName,s }</DisplayString>
		<Expand>
			<Synthetic Name="mesh groups">
				<DisplayString Condition="numMeshGroups == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numMeshGroups }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numMeshGroups</Size>
						<ValuePointer>(studioMeshGroupDesc_t*)((ubyte*)this + meshGroupsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="body groups">
				<DisplayString Condition="numBodyGroups == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numBodyGroups }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numBodyGroups</Size>
						<ValuePointer>(studioBodyGroup_t*)((ubyte*)this + bodyGroupsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="mesh lods">
				<DisplayString Condition="numLods == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numLods }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numLods</Size>
						<ValuePointer>(studioLodModel_t*)((ubyte*)this + lodsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="lod params">
				<DisplayString Condition="numLodParams == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numLodParams }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numLodParams</Size>
						<ValuePointer>(studioLodParams_t*)((ubyte*)this + lodParamsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="materials">
				<DisplayString Condition="numMaterials == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numMaterials }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numMaterials</Size>
						<ValuePointer>(studioMaterialDesc_t*)((ubyte*)this + materialsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="material paths">
				<DisplayString Condition="numMaterialSearchPaths == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numMaterialSearchPaths }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numMaterialSearchPaths</Size>
						<ValuePointer>(materialPathDesc_t*)((ubyte*)this + materialSearchPathsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="motion packs">
				<DisplayString Condition="numMotionPackages == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numMotionPackages }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numMotionPackages</Size>
						<ValuePointer>(motionPackageDesc_t*)((ubyte*)this + packagesOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="bones">
				<DisplayString Condition="numBones == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numBones }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numBones</Size>
						<ValuePointer>(studioBoneDesc_t*)((ubyte*)this + bonesOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="transforms">
				<DisplayString Condition="numTransforms == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numTransforms }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numTransforms</Size>
						<ValuePointer>(studioTransform_t*)((ubyte*)this + transformsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="ik chains">
				<DisplayString Condition="numIKChains == 0">[none]</DisplayString>
				<DisplayString>[count: { (int)numIKChains }]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>numIKChains</Size>
						<ValuePointer>(studioIkChain_t*)((ubyte*)this + ikChainsOffset)</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>
	<Type Name="studioLodModel_s">
		<Expand>
			<CustomListItems>
				<Variable Name="i" InitialValue="0" />
				<Loop>
					<If Condition="meshIndexes[i] == 255">
						<Break />
					</If>
					<Item Name="[{i}]">(int)meshIndexes[i]</Item>
					<Exec>++i</Exec>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>
	<Type Name="studioMeshGroupDesc_s">
		<DisplayString>[{ (int)numMeshes } meshes]</DisplayString>
		<Expand>
			<ArrayItems>
				<Size>numMeshes</Size>
				<ValuePointer>(studioMeshDesc_t*)((ubyte*)this + meshesOffset)</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="studioMaterialDesc_s">
		<DisplayString>{ materialname,s }</DisplayString>
		<Expand></Expand>
	</Type>
	<Type Name="materialPathDesc_s">
		<DisplayString>{ searchPath,s }</DisplayString>
		<Expand></Expand>
	</Type>
	<Type Name="studioBoneDesc_s">
		<DisplayString>{ name,s }</DisplayString>
	</Type>
	<Type Name="studioMeshDesc_s">
		<Intrinsic Name="MeshPrimType" Expression="(EStudioPrimType)mesh->primitiveType">
			<Parameter Name="mesh" Type="studioMeshDesc_s*" />
		</Intrinsic>
		<Intrinsic Name="MeshTriangleCount"
				   Expression="MeshPrimType(mesh) == STUDIO_PRIM_TRI_STRIP ? mesh->numIndices - 2 : mesh->numIndices / 3">
			<Parameter Name="mesh" Type="studioMeshDesc_s*" />
		</Intrinsic>
		
		<DisplayString>Mesh [{ numVertices } verts, { MeshTriangleCount(this) } tris]</DisplayString>
		<Expand>
			<Synthetic Name="prim type">
				<DisplayString>{ MeshPrimType(this) }</DisplayString>
			</Synthetic>
			<Synthetic Name="vert type">
				<DisplayString>{ (EStudioVertexStreamFlag)vertexType }</DisplayString>
			</Synthetic>
			<Item Name="materialIndex">(int)materialIndex</Item>
		</Expand>
	</Type>
</AutoVisualizer>